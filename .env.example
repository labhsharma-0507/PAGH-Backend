# ====== Zaroori ======
MONGO_URI=mongodb://127.0.0.1:27017/footwear_sos
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
ADMIN_EMAIL=admin@footwearsos.in
ADMIN_PASSWORD=Admin@12345
NODE_ENV=development
# Production mein alag domains par frontend/backend ho to: COOKIE_SAMESITE=none (HTTPS zaroori), TRUST_PROXY=true

# ====== API keys (jo daaloge wo feature live ho jayega; khaali = dev fallback) ======
# Payments (Razorpay). Webhook URL: {API_PUBLIC_URL}/api/v1/payments/webhook  (event: payment.captured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Google login. Google Cloud Console > Credentials > OAuth client ID (Web application):
#   Authorised JavaScript origins = WEB_ORIGIN (aur local ke liye http://localhost:3000). Client ID yahan daalo.
GOOGLE_CLIENT_ID=
# AI photo suggestion: OpenRouter (free models). Key: https://openrouter.ai/keys
# OPENROUTER_MODELS comma-separated fallback list; pehla fail/rate-limit ho to agla try hota hai.
# "openrouter/free" = OpenRouter ka free router (image dekhne wale free model khud chunta hai)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,google/gemma-3-27b-it:free
# Email (Resend)
RESEND_KEY=
MAIL_FROM=Footwear SOS <noreply@yourdomain.com>
# SMS + WhatsApp (Twilio). WhatsApp ke liye approved templates chahiye
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WA_FROM=
# Koi bhi aur provider (MSG91/Gupshup/n8n): har notification is URL par POST hoti hai
NOTIFY_WEBHOOK=
# Photos: S3-compatible (AWS S3 / Cloudflare R2 / MinIO). Khaali = local disk (api/uploads)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=
# Optional
DATA_KEY=
RUN_SCHEDULER=true
